    private void TryAddToOrder(DropItem dropItem)
    {
        if (items.Count(x => x.Identifier == "Order") >= 6)
        {
            Snackbar.Add("Cannot add more than 6 Bgm(s)", Severity.Error);
            return;
        }

        if (items.Any(x => x.Identifier == "Order" && x.Id == dropItem.Id))
        {
            return;
        }

        items.Add(dropItem);
        StateHasChanged();
        container.Refresh();
    }

    private DropItem CreateDropItemFromId(uint id)
    {
        // Legacy: resolve name from data file
        // var bgm = CommonDataService.GetBgmById(id);
        return new DropItem
        {
            Id = id,
            ValueJP = GetBgmDisplayName(id),
            Identifier = "Order"
        };
    }

    private static string GetBgmDisplayName(uint id) => $"BGM {id}";

