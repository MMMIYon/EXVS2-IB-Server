@using WebUIInfinite.Shared.Dto.Common
@using WebUIInfinite.Shared.Dto.Message

<MudGrid>
    <WebUIInfinite.Client.Pages.Components.Customize.Inner.CommunicationMessage
        CustomMessage="@CustomMessageGroup.StartMessage"
        DisplayLabel="@localizer["communicationmessage_verbalmessagestart"]"
        StampLabel="@localizer["communicationmessage_stampidstart"]"
        Templates="@Templates"
        EnableImagePreview="@EnableImagePreview"/>
</MudGrid>
