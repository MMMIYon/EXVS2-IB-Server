@inherits BasicCustomizeComponent
@using WebUIInfinite.Shared.Dto.Enum
@using WebUIInfinite.Client.Services.CustomMessage

@inject ICustomMessageTemplateService CustomMessageTemplateService

<MudGrid xs="12">
    <MudItem xs="12">
        <MudCard Class="my-2" Elevation="5">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">@localizer["communicationmessage"]</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudStack Row>
                        <MudProgressCircular @bind-Class="@ProgressContext.HideCommunicationMessageProgress" Color="Color.Default" Indeterminate="true"/>
                        <MudIconButton Icon="@Icons.Material.Filled.Save" Variant="Variant.Filled" OnClick="@SaveTask"
                                       Color="Color.Primary" Size="Size.Large" aria-label="save">
                        </MudIconButton>
                    </MudStack>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <MudStack>
                    <MudItem xs="12">
                        <MudSelect @bind-Value="CustomizeCardContext.CustomMessageGroupSetting.MessagePosition" Margin="Margin.Normal" T="MessagePosition"
                                   Label="@localizer["communicationmessage_position"]" Variant="Variant.Outlined" ToStringFunc="@ConvertMessagePosition">
                            @foreach (var item in Enum.GetValues<MessagePosition>())
                            {
                                <MudSelectItem Value="@(item)" />
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="6" Class="my-auto mud-typography mud-typography-body1">
                                @localizer["communicationmessage_allow_receive_message"]
                            </MudItem>
                            <MudItem xs="6" Class="my-auto">
                                <MudSwitch @bind-Value="@CustomizeCardContext.CustomMessageGroupSetting.AllowReceiveMessage" Color="Color.Primary"
                                           Label=""
                                           LabelPlacement="Placement.Start"/>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid Class="align-center">
                            <MudItem xs="10" sm="11">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body1">@localizer["communicationmessage_command_auto_flag"]</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@localizer["communicationmessage_command_auto_flag_hint"]</MudText>
                                </MudStack>
                            </MudItem>
                            <MudItem xs="2" sm="1" Class="d-flex justify-end my-auto">
                                <MudSwitch @bind-Value="@CustomizeCardContext.CustomMessageGroupSetting.CommandMessageAutoFlag" Color="Color.Primary"
                                           Label=""
                                           LabelPlacement="Placement.Start"/>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid Class="align-center">
                            <MudItem xs="12">
                                <MudExpansionPanels>
                                    <MudForm @ref="_messageForm">
                                        <MudExpansionPanel Text="@localizer["communicationmessage_solo"]">
                                            <WebUIInfinite.Client.Pages.Components.Customize.Inner.CommunicationMessageGroup
                                                CustomMessageGroup="@CustomizeCardContext.CustomMessageGroupSetting.SoloGroup"
                                                EnableImagePreview="@EnableImagePreview"
                                                Templates="@CombinedTemplates"/>
                                        </MudExpansionPanel>
                                        <MudExpansionPanel Text="@localizer["communicationmessage_team"]">
                                            <WebUIInfinite.Client.Pages.Components.Customize.Inner.CommunicationMessageGroup
                                                CustomMessageGroup="@CustomizeCardContext.CustomMessageGroupSetting.TeamGroup"
                                                EnableImagePreview="@EnableImagePreview"
                                                Templates="@CombinedTemplates"/>
                                        </MudExpansionPanel>
                                        <MudExpansionPanel Text="@localizer["communicationmessage_instant_team"]">
                                            <WebUIInfinite.Client.Pages.Components.Customize.Inner.CommunicationMessageGroup
                                                CustomMessageGroup="@CustomizeCardContext.CustomMessageGroupSetting.InstantTeamGroup"
                                                EnableImagePreview="@EnableImagePreview"
                                                Templates="@CombinedTemplates"/>
                                        </MudExpansionPanel>
                                    </MudForm>
                                </MudExpansionPanels>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code{
    [Parameter]
    public bool EnableImagePreview { get; set; } = true;

    MudForm _messageForm;

    // Each per-mode CommandMessageData has 6 directions. To keep the autocomplete templates
    // useful regardless of whether the slot semantically maps to opening/playing/result on the
    // legacy data, we union all template buckets so users get the full suggestion list.
    private string[] CombinedTemplates =>
        CustomMessageTemplateService.GetMessageTemplates().OpenTemplates
            .Concat(CustomMessageTemplateService.GetMessageTemplates().BattleTemplates)
            .Concat(CustomMessageTemplateService.GetMessageTemplates().ResultTemplates)
            .Distinct()
            .ToArray();

    string ConvertMessagePosition(MessagePosition messagePosition)
    {
        return messagePosition == MessagePosition.Center
            ? localizer["communicationmessage_position_type_center"]
            : localizer["communicationmessage_position_type_left_bottom"];
    }
}
